# ─────────────────────────────────────────────────────────────────────────────
# Rakshak — environment reference. No secrets belong here or in a real .env —
# every Lambda uses its execution role (see docs/SECURITY_MODEL.md), and every
# frontend variable below ships in the public browser bundle.
# ─────────────────────────────────────────────────────────────────────────────

# ── Deploy tooling (deploy/deploy.py) ──────────────────────────────────────
AWS_PROFILE=agent-toolkit
AWS_REGION=ap-south-1
EXPECTED_ACCOUNT=468704514492
API_ID=aksdwfbnn5

# ── Backend Lambda config (set on the function, not read from a local .env —
#    listed here so the full config surface is visible in one place) ───────
AWS_REGION_OVERRIDE=ap-south-1
PATROLS_TABLE=rakshak-patrols
SOS_TABLE=rakshak-sos-alerts
USERS_TABLE=rakshak-users
INCIDENTS_TABLE=rakshak-incidents
SAGEMAKER_ENDPOINT=rakshak-risk-endpoint
MODEL_BUCKET=rakshak-models-vishalganesan
MODEL_KEY=models/v2/booster.json
PATROL_SPEED_KMPH=40
DIVERT_SPEED_KMPH=55
ARRIVE_RADIUS_M=120
BUILD_VERSION=1.0.0

# ── Frontends (citizen-app, police-app, dashboard) ─────────────────────────
# Backend API — HTTP API aksdwfbnn5, stage is $default so there is NO stage
# path segment (no /prod, no /dev).
VITE_API_BASE_URL=https://aksdwfbnn5.execute-api.ap-south-1.amazonaws.com
VITE_AWS_REGION=ap-south-1

# Map tiles — leave VITE_MAP_API_KEY blank to use free OSM raster tiles.
VITE_MAP_API_KEY=
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
VITE_MAP_DEFAULT_CENTER=13.0827,80.2707
VITE_MAP_DEFAULT_ZOOM=12

# Polling intervals (ms) — the backend is polled, there are no websockets.
VITE_POLL_PATROLS_MS=3000
VITE_POLL_SOS_FEED_MS=2000
VITE_POLL_DASHBOARD_SNAPSHOT_MS=5000
VITE_POLL_HEATMAP_MS=10000
VITE_POLL_PREDICTION_MS=15000
VITE_POLL_MY_INCIDENT_MS=2000
VITE_MARKER_LERP_MS=3000
